const artifactButton = document.querySelector("#artifact-button");

function isInAppViewer() {
  const ua = navigator.userAgent || "";
  return /Instagram|FBAN|FBAV|FB_IAB|FB4A|FBIOS|Messenger|Line\/|Twitter|TikTok|LinkedInApp|Pinterest|Snapchat|\bwv\b/i.test(ua);
}

function showDownloadHelp() {
  if (copyLinkStatus) {
    copyLinkStatus.textContent = "";
  }

  if (downloadHelp && typeof downloadHelp.showModal === "function") {
    downloadHelp.showModal();
    return;
  }

  window.alert("The ritual works here. Only the final artifact download needs Safari, Chrome, or your system browser.");
}

async function copyExperienceLink() {
  if (!copyLinkStatus) return;

  try {
    await navigator.clipboard.writeText(experienceUrl);
    copyLinkStatus.textContent = "Link copied.";
  } catch {
    copyLinkStatus.textContent = "Copy this link: pneuma.averylakeofficial.com";
  }
}

/**
 * Generate a unique hash from timestamp + random bytes.
 * Returns a short hex string like "a7f3e2b1".
 */
function generateHash() {
  const timestamp = Date.now().toString(36);
  const random = Math.random().toString(36).substring(2, 8);
  const raw = timestamp + random;
  let hash = 0;
  for (let i = 0; i < raw.length; i++) {
    const char = raw.charCodeAt(i);
    hash = ((hash << 5) - hash) + char;
    hash = hash & hash;
  }
  return Math.abs(hash).toString(16).padStart(8, "0").slice(0, 8);
}

function resetArtifactButton() {
  if (!artifactButton) return;
  artifactButton.textContent = "Download artifact";
  artifactButton.disabled = false;
}

function downloadBlob(blob, filename) {
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = filename;
  a.style.display = "none";
  document.body.appendChild(a);
  a.click();
  a.remove();
  setTimeout(() => URL.revokeObjectURL(url), 1000);
}

function generateArtifact() {
  if (isInAppViewer()) {
    showDownloadHelp();
    return;
  }

  if (artifactButton) {
    artifactButton.textContent = "Preparing artifact...";
    artifactButton.disabled = true;
  }

  setTimeout(() => {
    try {
      const W = 2400;
      const H = 3200;
      const canvas = document.createElement("canvas");
      canvas.width = W;
      canvas.height = H;
      const ctx = canvas.getContext("2d");

      /* ── Pure white — breath ─────────────── */
      ctx.fillStyle = "#ffffff";
      ctx.fillRect(0, 0, W, H);

      /* ── Bottom edge typography ──────────── */
      const margin = 80;
      const bottomY = H - margin;
      const textColor = "rgba(0, 0, 0, 0.28)";
      const fontSize = 18;

      ctx.fillStyle = textColor;
      ctx.textBaseline = "bottom";

      /* Bottom left: hash */
      const hash = generateHash();
      ctx.textAlign = "left";
      ctx.font = `300 ${fontSize}px Inter, 'Helvetica Neue', sans-serif`;
      ctx.letterSpacing = "1px";
      ctx.fillText(`#${hash}`, margin, bottomY);
      ctx.letterSpacing = "0px";

      /* Bottom center: Pneuma (1/1) */
      ctx.textAlign = "center";
      ctx.font = `italic 300 ${fontSize}px Georgia, 'Times New Roman', serif`;
      ctx.fillText("Pneuma (1/1)", W / 2, bottomY);

      /* Bottom right: Avery Lake */
      ctx.textAlign = "right";
      ctx.font = `300 ${fontSize}px Inter, 'Helvetica Neue', sans-serif`;
      ctx.letterSpacing = "1px";
      ctx.fillText("Avery Lake", W - margin, bottomY);
      ctx.letterSpacing = "0px";

      /* ── Download — mirrors The Logos path ─ */
      const filename = `pneuma-${hash}.png`;
      canvas.toBlob((blob) => {
        if (!blob) {
          resetArtifactButton();
          showDownloadHelp();
          return;
        }

        downloadBlob(blob, filename);
        resetArtifactButton();
      }, "image/png");
    } catch {
      resetArtifactButton();
      showDownloadHelp();
    }
  }, 100);
}

