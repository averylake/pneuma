/* ── Soundtrack ──────────────────────────── */

function updateSoundButton() {
  if (!soundButton) return;

  const isPlaying = soundtrack && !soundtrack.paused;
  soundButton.classList.toggle("is-muted", !soundEnabled);
  soundButton.setAttribute("aria-pressed", String(soundEnabled));

  if (!soundEnabled) {
    soundButton.setAttribute("aria-label", "Turn sound on");
  } else if (isPlaying) {
    soundButton.setAttribute("aria-label", "Turn sound off");
  } else {
    soundButton.setAttribute("aria-label", "Start sound");
  }
}

function fadeSoundVolume(targetVolume, duration = 1100, afterFade) {
  if (!soundtrack) return;

  if (soundFadeFrame) {
    cancelAnimationFrame(soundFadeFrame);
  }

  const startVolume = soundtrack.volume;
  const startTime = performance.now();

  const step = (now) => {
    const progress = Math.min((now - startTime) / duration, 1);
    const eased = 1 - Math.pow(1 - progress, 3);
    soundtrack.volume = startVolume + ((targetVolume - startVolume) * eased);

    if (progress < 1) {
      soundFadeFrame = requestAnimationFrame(step);
    } else {
      soundFadeFrame = null;
      if (afterFade) afterFade();
    }
  };

  soundFadeFrame = requestAnimationFrame(step);
}

async function startSound() {
  if (!soundtrack || !soundEnabled) return;

  try {
    if (soundtrack.paused) {
      soundtrack.volume = 0;
      await soundtrack.play();
    }
    fadeSoundVolume(0.42);
  } catch {
    soundEnabled = false;
  } finally {
    updateSoundButton();
  }
}

function stopSound() {
  if (!soundtrack) return;
  fadeSoundVolume(0, 650, () => {
    soundtrack.pause();
  });
  updateSoundButton();
}

function toggleSound() {
  if (!soundtrack) return;

  if (!soundEnabled) {
    soundEnabled = true;
    startSound();
    updateSoundButton();
    return;
  }

  if (soundtrack.paused) {
    startSound();
    return;
  }

  soundEnabled = false;
  stopSound();
}

/* ── Dust mote particles ─────────────────── */

function createDustMotes() {
  if (!fogContainer) return;
  const count = 25;
  for (let i = 0; i < count; i++) {
    const mote = document.createElement("div");
    mote.className = "dust-mote";
    mote.style.left = `${Math.random() * 100}%`;
    mote.style.top = `${Math.random() * 100}%`;
    mote.style.setProperty("--mote-duration", `${15 + Math.random() * 20}s`);
    mote.style.setProperty("--mote-delay", `${Math.random() * 15}s`);
    mote.style.setProperty("--mote-dx", `${(Math.random() - 0.5) * 80}px`);
    mote.style.setProperty("--mote-dy", `${-20 - Math.random() * 100}px`);
    mote.style.width = `${1 + Math.random() * 2}px`;
    mote.style.height = mote.style.width;
    fogContainer.appendChild(mote);
  }
}

/* ── Render masks ────────────────────────── */

function scaleLength(length, factor) {
  const match = String(length).trim().match(/^(-?\d*\.?\d+)([a-z%]+)$/i);
  if (!match) return "0rem";

  const value = Number(match[1]) * factor;
  const unit = match[2];
  const rounded = Number(value.toFixed(4));
  return `${Object.is(rounded, -0) ? 0 : rounded}${unit}`;
}

function driftStyle(dx, dy) {
  return [
    `--float-x-25: ${scaleLength(dx, -0.55)}`,
    `--float-y-25: ${scaleLength(dy, 0.55)}`,
    `--float-x-50: ${scaleLength(dx, 1.1)}`,
    `--float-y-50: ${scaleLength(dy, 1.1)}`,
    `--float-x-75: ${scaleLength(dx, 0.45)}`,
    `--float-y-75: ${scaleLength(dy, -0.75)}`
  ].join("; ");
}

function renderMasks() {
  maskLayer.innerHTML = masks.map((mask) => `
    <button
      class="mask-node"
      type="button"
      data-mask="${mask.id}"
      aria-label="Open ${mask.label} mask"
      style="--x: ${mask.x}; --y: ${mask.y}; --duration: ${mask.duration}; ${driftStyle(mask.dx, mask.dy)};"
    >
      <img src="${mask.image}?v=${assetVersion}" alt="${mask.label} mask" draggable="false" />
      <span class="porcelain-surface" aria-hidden="true"><span></span></span>
      <span class="mask-mark mask-mark--${mask.mark}" aria-hidden="true"><span></span></span>
      <span class="mask-label-text">${mask.label}</span>
    </button>
  `).join("");

  maskLayer.querySelectorAll(".mask-node").forEach((node) => {
    node.addEventListener("click", () => openReflection(node.dataset.mask));
  });

  /* Stagger mask entrance */
  maskLayer.querySelectorAll(".mask-node").forEach((node, i) => {
    setTimeout(() => {
      node.classList.add("is-visible");
    }, 300 + i * 350);
  });
}

/* ── Progress dots ───────────────────────── */

function renderProgress() {
  progressDots.innerHTML = masks.map((mask) => `
    <span class="progress-dot ${released.has(mask.id) ? "is-done" : ""}"></span>
  `).join("");
  progressText.textContent = `${released.size} of ${masks.length} identities released.`;
  document.body.style.setProperty("--release-depth", (released.size / masks.length).toFixed(3));
}

/* ── Reflection dialog ───────────────────── */

function openReflection(maskId) {
  const mask = masks.find((item) => item.id === maskId);
  if (!mask) return;

  startSound();
  activeMaskId = maskId;
  reflectionKicker.textContent = mask.label;
  reflectionCopy.innerHTML = mask.copy.map((line) => `<p>${line}</p>`).join("");
  reflection.showModal();
}

/* ── Release mask ────────────────────────── */

function releaseActiveMask() {
  if (!activeMaskId) return;

  const node = maskLayer.querySelector(`[data-mask="${activeMaskId}"]`);
  released.add(activeMaskId);
  renderProgress();

  if (reflection.open) {
    reflection.close("release");
  }

  if (node) {
    node.classList.add("is-releasing");
    let releaseFinished = false;
    const finishRelease = () => {
      if (releaseFinished) return;
      releaseFinished = true;
      node.remove();
      if (released.size === masks.length) {
        revealEnding();
      }
    };
    node.addEventListener("animationend", finishRelease, { once: true });
    setTimeout(finishRelease, 1400);
  } else if (released.size === masks.length) {
    revealEnding();
  }

  activeMaskId = null;
}

/* ── Reveal ending ───────────────────────── */

function revealEnding() {
  document.body.classList.add("revealed");
  reveal.setAttribute("aria-hidden", "false");
}

/* ── Restart ─────────────────────────────── */

function restartExperiment() {
  released.clear();
  activeMaskId = null;
  document.body.classList.remove("revealed");
  reveal.setAttribute("aria-hidden", "true");
  renderMasks();
  renderProgress();
}

