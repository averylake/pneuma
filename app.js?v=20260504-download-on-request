  soundButton.addEventListener("click", toggleSound);
}
copyExperienceLinkButton.addEventListener("click", copyExperienceLink);

reflection.addEventListener("close", () => {
  if (reflection.returnValue !== "release") {
    activeMaskId = null;
  }
});

reflection.addEventListener("click", (event) => {
  const bounds = reflection.querySelector(".reflection__inner").getBoundingClientRect();
  const clickedOutside =
    event.clientX < bounds.left ||
    event.clientX > bounds.right ||
    event.clientY < bounds.top ||
    event.clientY > bounds.bottom;

  if (clickedOutside) {
    reflection.close("cancel");
  }
});

